API_PORT=8000
API_HOST=0.0.0.0
# CORS 白名单，逗号分隔
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000

# ================================================================ 模型接入
# 本项目不是模型中转站：模型名 / API Key / Base URL / 单价都由使用者填写。
# 下面这些是**兜底默认值**；界面「系统设置 → 模型配置」（仅管理员）里填的项优先，
# 且改完立即生效、无需重启。
LLM_API_KEY=your_api_key
LLM_API_BASE=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# Embedding 走 OpenAI 兼容接口（DeepSeek 不提供 embedding）。
# EMBEDDING_API_KEY 留空时回退复用 LLM_API_KEY。
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_DIMENSIONS=1024

# ================================================================ 成本与预算
# 单价单位：LLM_PRICE_CURRENCY / 百万 token。留 0 = 成本恒为 0，
# 此时**预算保护不生效**（宁可跳过保护，也不能因为忘配价格把业务卡死）。
# DeepSeek 官方报价为人民币，故默认 CNY。
LLM_INPUT_PRICE_PER_MILLION=0
LLM_OUTPUT_PRICE_PER_MILLION=0
LLM_PRICE_CURRENCY=CNY
# 高峰价倍数：1 = 不分时段。DeepSeek 为 2（高峰 = 空闲 × 2）
LLM_PEAK_MULTIPLIER=1.0
LLM_BUDGET_ENABLED=true
LLM_BUDGET_PERIOD=daily          # daily | monthly
# 预算上限，币种与 LLM_PRICE_CURRENCY 一致
LLM_BUDGET_AMOUNT=5.0
LLM_BUDGET_ACTION=halt           # halt=停止调用并转人工 / warn=仅告警
LLM_BUDGET_REFRESH_EVERY=20      # 每 N 次调用回读一次数据库
LLM_LOG_RETENTION_DAYS=90        # llm_call_logs 保留天数

# ================================================================ 模型调用参数
LLM_TEMPERATURE=0.1              # 评分类任务建议低温，保证结果稳定
LLM_TIMEOUT_SECONDS=45
# 同时在途调用数上限（0 = 不限）。批量筛简历时 N 个候选人 × 每人 4~8 次调用
# 会瞬间放大成 N×8 个请求，容易撞上供应商并发上限（DeepSeek：flash 2500 / pro 500）。
LLM_MAX_CONCURRENCY=8

# ================================================================ 业务阈值
AUTO_START_WORKFLOW=true
# 文化契合三段判定：>=60 通过 / [50,60) 转人工复核 / <50 淘汰
CULTURE_PASS_THRESHOLD=60
CULTURE_REVIEW_THRESHOLD=50
# 带「待人工复核」标记时是否跳过第三轮面试
SKIP_ROUND3_ON_REVIEW=false
SCORING_VERSION=v2

# ================================================================ 数据库
DATABASE_URL=sqlite:///./recruitment.db
SQLITE_URL=sqlite:///./recruitment.db

# ================================================================ 向量库
# chroma = 本地持久化（默认）；milvus 需另起服务
VECTOR_STORE_BACKEND=chroma
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=recruitment_knowledge

# ================================================================ 安全
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 登录失败限流（防爆破 / 防撞库）。
# /auth/login 是唯一无需凭据即可调用的写路径，没有失败计数时端口可达即等于可被爆破。
# 按用户名与来源 IP 两个维度记：只记用户名挡不住"一个口令试遍所有用户名"的撞库。
LOGIN_MAX_FAILED_PER_USER=5
LOGIN_MAX_FAILED_PER_IP=20        # 放宽，避免办公室共用出口 IP 被整体锁住
LOGIN_FAILURE_WINDOW_SECONDS=900  # 失败计数窗口
LOGIN_LOCKOUT_SECONDS=900         # 触发后锁定时间

# ================================================================ 运行
DEBUG=true
LOG_LEVEL=INFO

# ================================================================ 预留（当前代码未读取）
# 下列连接信息在 config.py 中有声明，但当前实现未使用（默认走本地 SQLite +
# Chroma 持久化 + SSE 通知）。保留说明以免误以为配了就会生效，需要时再接入。
# REDIS_URL=redis://localhost:6379/0        # 未使用：未引入缓存/队列
# RABBITMQ_URL=amqp://guest:guest@localhost:5672/   # 未使用：无异步任务队列
# MINIO_ENDPOINT=localhost:9000             # 未使用：文件存本地磁盘
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
